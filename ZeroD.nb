Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Phi]", "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "575a9144-3dcc-3844-bb5c-287e14d77df2"],
 " in Zero Dimensions (0D)"
}], "Title",
 CellChangeTimes->{{4.0033822442828903`*^9, 4.003382318094164*^9}, {
  4.003382390378153*^9, 4.0033823929767475`*^9}, {4.003382437897625*^9, 
  4.0033824399310455`*^9}},ExpressionUUID->"a0c6e1d9-a0c3-6640-bce2-\
2bd8258ca025"],

Cell["Initial investigation", "Subtitle",
 CellChangeTimes->{{4.0033824106112804`*^9, 4.00338245921097*^9}, {
  4.0033846552554016`*^9, 4.0033846568807507`*^9}, {4.0033847202383842`*^9, 
  4.003384751454502*^9}},ExpressionUUID->"5fe5e9dd-2093-ac4f-9803-\
507eef820c87"],

Cell[TextData[{
 "Consider a function z of a single continuous variable x with coupling \
constant g. This consists of a free action (",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "81fcd775-b183-b949-82d2-979f82ce9d57"],
 ") term and an interaction (",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SuperscriptBox["x", "4"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2ebab351-1aee-2c4e-bf4b-f10e39c3c43b"],
 ") term."
}], "Text",
 CellChangeTimes->{{4.0033825467609596`*^9, 4.003382615976059*^9}, {
  4.003382653628908*^9, 4.0033826545782185`*^9}, {4.0033829121769695`*^9, 
  4.0033830073042736`*^9}, {4.0033887720527325`*^9, 4.003388773702183*^9}, {
  4.003390587210211*^9, 
  4.0033906668535175`*^9}},ExpressionUUID->"9e839171-679f-e548-b48b-\
d568c2f22a40"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"interaction", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["g", 
      RowBox[{"4", "!"}]]}], 
    SuperscriptBox["x", "4"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"free", " ", "=", " ", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox["x", "2"], "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z", "=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{"2", "\[Pi]"}]]], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"(", 
        RowBox[{"interaction", "+", "free"}], ")"}]], 
      RowBox[{"\[DifferentialD]", "x"}]}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.003382626379324*^9, 4.003382646443014*^9}, {
  4.0033827062915363`*^9, 4.003382714791115*^9}, {4.0033827482740192`*^9, 
  4.003382885604994*^9}, {4.0033830340937977`*^9, 4.0033830700864677`*^9}, {
  4.0033831459682617`*^9, 4.003383170235428*^9}, {4.003383339780342*^9, 
  4.0033833529144115`*^9}, {4.0033833998475246`*^9, 4.0033834047360325`*^9}, {
  4.0033846264746666`*^9, 4.0033846307728443`*^9}, {4.003384772036291*^9, 
  4.003384786855425*^9}, {4.003385121928211*^9, 4.0033851354284534`*^9}, {
  4.0033869282783394`*^9, 4.0033869446125793`*^9}, {4.0033894196135235`*^9, 
  4.003389433172121*^9}, {4.003389749021042*^9, 4.003389794584404*^9}},
 CellLabel->
  "In[245]:=",ExpressionUUID->"463f9bf8-ec93-004f-aac1-fe941bd4abb7"],

Cell[TextData[{
 "For small g we can expand the exponential of the interaction component as:\n\
\n exp(",
 Cell[BoxData[
  RowBox[{
   RowBox[{"-", 
    FractionBox["g", 
     RowBox[{"4", "!"}]]}], 
   SuperscriptBox["x", "4"]}]], "Input",
  CellChangeTimes->{{4.003382626379324*^9, 4.003382646443014*^9}, {
   4.0033827062915363`*^9, 4.003382714791115*^9}, {4.0033827482740192`*^9, 
   4.003382885604994*^9}, {4.0033830340937977`*^9, 4.0033830700864677`*^9}, {
   4.0033831459682617`*^9, 4.003383170235428*^9}, {4.003383339780342*^9, 
   4.0033833529144115`*^9}, {4.0033833998475246`*^9, 
   4.0033834047360325`*^9}, {4.0033846264746666`*^9, 
   4.0033846307728443`*^9}, {4.003384772036291*^9, 4.003384786855425*^9}, {
   4.003385121928211*^9, 4.0033851354284534`*^9}},ExpressionUUID->
  "0558fd7f-19a0-204e-9ba1-90452c2bae52"],
 ") = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "0"}], "\[Infinity]"], 
    RowBox[{
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "n"], 
      RowBox[{"n", "!"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["g", 
        RowBox[{"4", "!"}]], ")"}], "n"], 
     SuperscriptBox["x", 
      RowBox[{"4", "n"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b1aa1ecc-5659-d645-b1b7-f8c302c1b2e4"],
 "\n \n And then to remove the x dependence we evaluate the integral:\n \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    SuperscriptBox["\[ExponentialE]", 
     FractionBox[
      RowBox[{"-", 
       SuperscriptBox["x", "2"]}], "2"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "78e8cc5e-7dd1-dc4e-bd8d-6f2a423d2b94"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"4", "n"}]], TraditionalForm]],ExpressionUUID->
  "b256b65f-73f1-ef48-9a69-9bdc49463106"],
 "\[DifferentialD]x"
}], "Text",
 CellChangeTimes->{{4.0033831024357147`*^9, 4.0033831175895805`*^9}, {
  4.003383380483713*^9, 4.0033833808310547`*^9}, {4.003383997133795*^9, 
  4.003384003091837*^9}, {4.0033848721367054`*^9, 4.0033850328792152`*^9}, {
  4.003385148942974*^9, 4.003385299358219*^9}, {4.003385337054617*^9, 
  4.0033853478894577`*^9}, {4.003390253436758*^9, 4.003390314448435*^9}, {
  4.003394186464033*^9, 
  4.0033941976784782`*^9}},ExpressionUUID->"ecb70b0b-0786-c94b-af7c-\
f1b95212359e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"xIntegrand", " ", "=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"x", "^", "2"}]}], "/", "2"}], "]"}], " ", 
    RowBox[{"x", "^", 
     RowBox[{"(", 
      RowBox[{"4", "n"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"gammaFactor", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{"xIntegrand", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{
      RowBox[{"n", "\[Element]", "Integers"}], "&&", 
      RowBox[{"n", ">=", "0"}]}]}]}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{4.0033831289855595`*^9, 4.0033831325363655`*^9}, {
   4.003383293799652*^9, 4.0033833086654034`*^9}, {4.003383414230484*^9, 
   4.0033835112629757`*^9}, {4.003384117622385*^9, 4.003384130774252*^9}, {
   4.0033841627731686`*^9, 4.00338417571999*^9}, {4.0033842407269306`*^9, 
   4.0033842638498173`*^9}, {4.003384302796997*^9, 4.0033843033785763`*^9}, {
   4.003385358505966*^9, 4.003385381803135*^9}, {4.003385417670267*^9, 
   4.003385443188547*^9}, {4.0033854740010014`*^9, 4.0033855199197025`*^9}, {
   4.003385567581873*^9, 4.0033855723822803`*^9}, {4.0033856119836273`*^9, 
   4.0033856164654217`*^9}, {4.0033856727455997`*^9, 4.0033856824289417`*^9}, 
   4.003385727577984*^9, {4.003385758776781*^9, 4.003385781592884*^9}, {
   4.0033858266921024`*^9, 4.003385827025444*^9}, {4.003385906306614*^9, 
   4.003386209914049*^9}, {4.003386278296259*^9, 4.003386329627121*^9}, {
   4.0033903248973923`*^9, 4.003390338834608*^9}},
 CellLabel->
  "In[248]:=",ExpressionUUID->"9a5f257a-707d-954f-8f45-24799397c40e"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["2", 
   RowBox[{
    FractionBox["1", "2"], "+", 
    RowBox[{"2", " ", "n"}]}]], " ", 
  RowBox[{"Gamma", "[", 
   RowBox[{
    FractionBox["1", "2"], "+", 
    RowBox[{"2", " ", "n"}]}], "]"}]}]], "Output",
 CellChangeTimes->{
  4.003385526765604*^9, 4.0033855778143387`*^9, 4.0033856205129604`*^9, {
   4.003385678911495*^9, 4.003385687127945*^9}, {4.003385788531273*^9, 
   4.0033858335910206`*^9}, {4.0033861482490807`*^9, 4.0033861650148735`*^9}, 
   4.0033862832945576`*^9, 4.00338633617622*^9, 4.003394172230221*^9},
 CellLabel->
  "Out[249]=",ExpressionUUID->"8e9e2965-4d20-a549-8c57-8bcf818f5fa0"]
}, Open  ]],

Cell[TextData[{
 "Note that this gammaFactor is equivalent to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     RowBox[{"2", "\[Pi]"}]], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", "n"}], "-", "1"}], ")"}], "!!"}], " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4073efc8-98e3-8346-99d4-c9752249d19a"],
 " or equivalently as factorials ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"4", "n"}], ")"}], "!"}], 
    RowBox[{
     SuperscriptBox["4", "n"], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "n"}], ")"}], "!"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "da8ef421-829f-b54d-a388-402985836ad3"],
 " \nUsing this we can express the series z as the sum as the following (and \
as an example compute for n 0 -> 3):"
}], "Text",
 CellChangeTimes->{{4.0033863435435047`*^9, 4.003386373462538*^9}, {
   4.0033864135763855`*^9, 4.0033865132252426`*^9}, {4.0033866117360706`*^9, 
   4.0033866118531685`*^9}, {4.0033868575795383`*^9, 4.003386915826832*^9}, {
   4.0033869642572403`*^9, 4.0033873033651733`*^9}, {4.0033873351477356`*^9, 
   4.003387393746313*^9}, 4.003387444458927*^9, {4.0033878491795864`*^9, 
   4.003387850697588*^9}, {4.0033884694274044`*^9, 4.003388558444994*^9}, {
   4.00339421339592*^9, 
   4.0033942274798126`*^9}},ExpressionUUID->"4fb7fa78-19b7-0646-9a30-\
59589d8766f8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"zSeriesTerms", "=", 
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "n"], "  ", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", "n"}], ")"}], "!"}], 
      RowBox[{
       SuperscriptBox["2", 
        RowBox[{"2", "n"}]], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "n"}], ")"}], "!"}], 
       RowBox[{"n", "!"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"4", "!"}], ")"}], "n"]}]], 
     SuperscriptBox["g", "n"]}],
    TraditionalForm]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"zFirstThreeTerms", "=", " ", 
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "0"}], "3"], "zSeriesTerms"}],
   TraditionalForm]}]}], "Input",
 CellChangeTimes->{{4.0033874906289253`*^9, 4.003387514958103*^9}, {
   4.0033875517048416`*^9, 4.003387630244049*^9}, {4.0033877416914654`*^9, 
   4.0033877561962624`*^9}, {4.0033877940505276`*^9, 
   4.0033878325527477`*^9}, {4.0033878696744843`*^9, 
   4.0033878726228905`*^9}, {4.0033880521708984`*^9, 4.0033880669588146`*^9}, 
   4.00338859582415*^9, {4.0033888010174713`*^9, 4.0033888102599525`*^9}, {
   4.003390361315956*^9, 4.0033903790146904`*^9}, 4.003390814049122*^9},
 CellLabel->
