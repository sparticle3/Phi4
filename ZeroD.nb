Cell["\<\
The 0D case is especially informative, as we can evaluate the exact integral \
and compare it with the perturbative approximation:\
\>", "Text",
 CellChangeTimes->{{4.003388608989916*^9, 
  4.003388715686428*^9}},ExpressionUUID->"93bb3a34-446a-994e-899c-\
311d391275e9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"interactionTerm", "[", 
    RowBox[{"g_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"g", "/", 
       RowBox[{"4", "!"}]}], ")"}]}], " ", 
    RowBox[{"x", "^", "4"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"freeTerm", "[", "x_", "]"}], ":=", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", "^", "2"}], "/", "2"}], ")"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ZExact", "[", 
    RowBox[{"gVal_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"\[ExponentialE]", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"freeTerm", "[", "x", "]"}], "+", 
         RowBox[{"interactionTerm", "[", 
          RowBox[{"gVal", ",", "x"}], "]"}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}], "/", 
    SqrtBox[
     RowBox[{"2", "\[Pi]"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ZPerturbative", "[", "gVal_", "]"}], ":=", 
   RowBox[{"zFirstThreeTerms", " ", "/.", " ", 
    RowBox[{"g", "->", " ", "gVal"}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gValues", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "1", ",", "0.1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"allData", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"gVal", ",", 
        RowBox[{"ZExact", "[", "gVal", "]"}], ",", 
        RowBox[{"ZPerturbative", "[", "gVal", "]"}], ",", " ", 
        RowBox[{
         RowBox[{"ZExact", "[", "gVal", "]"}], "-", 
         RowBox[{"ZPerturbative", "[", "gVal", "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"gVal", ",", "gValues"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PrependTo", "[", 
   RowBox[{"allData", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<g\>\"", ",", "\"\<Exact Z(g)\>\"", 
      ",", "\"\<Perturbative Z(g)\>\"", ",", " ", "\"\<Diff\>\""}], "}"}]}], 
   "]"}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{"allData", ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", "Left"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.0033887347193794`*^9, 4.0033887347193794`*^9}, 
   4.003388919329544*^9, {4.0033890060638027`*^9, 4.003389062224535*^9}, {
   4.0033890948911266`*^9, 4.0033890950053864`*^9}, {4.003389160604973*^9, 
   4.003389185235733*^9}, 4.003389271350485*^9, 4.003389392911398*^9, 
   4.003389427113901*^9, {4.0033896281136055`*^9, 4.003389675671522*^9}, {
   4.003389847765011*^9, 4.0033898738830967`*^9}, {4.0033899132838383`*^9, 
   4.0033899152969627`*^9}, {4.003389945885807*^9, 4.003390009044613*^9}, {
   4.0033900774580727`*^9, 4.0033900918234386`*^9}, {4.00339047492774*^9, 
   4.0033905174628105`*^9}, {4.0033907226844807`*^9, 4.003390993340849*^9}, {
   4.00339103169499*^9, 4.003391035040943*^9}, {4.0033910797258873`*^9, 
   4.00339110663982*^9}, {4.0033934822236004`*^9, 4.0033935254704723`*^9}, {
   4.0033939932867203`*^9, 4.0033940230698814`*^9}, {4.003394131682186*^9, 
   4.00339414568355*^9}},
 CellLabel->
  "In[252]:=",ExpressionUUID->"755ac270-ea8c-624d-811b-01b707b89749"],

