 RowBox[{"1", "-", 
  FractionBox["g", "8"], "+", 
  FractionBox[
   RowBox[{"35", " ", 
    SuperscriptBox["g", "2"]}], "384"], "-", 
  FractionBox[
   RowBox[{"385", " ", 
